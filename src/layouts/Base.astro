---
import '../styles/global.css';
import fontLatin from '@fontsource-variable/bricolage-grotesque/files/bricolage-grotesque-latin-wght-normal.woff2?url';
import fontVi from '@fontsource-variable/bricolage-grotesque/files/bricolage-grotesque-vietnamese-wght-normal.woff2?url';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  page?: 'home' | 'work' | 'case' | 'other';
}

const {
  title = 'Xinh Nguyễn · XINH.OS',
  description = 'Xinh Nguyễn — marketing & communication, làm chủ dự án từ mục tiêu đến kết quả. Ưu tiên Banking & Fintech. TP.HCM hoặc remote.',
  page = 'home',
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);

const fontCss = `
@font-face{font-family:'Bricolage';font-style:normal;font-display:swap;font-weight:200 800;src:url(${fontLatin}) format('woff2-variations');unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2190-2193,U+2212,U+2215,U+FEFF,U+FFFD}
@font-face{font-family:'Bricolage';font-style:normal;font-display:swap;font-weight:200 800;src:url(${fontVi}) format('woff2-variations');unicode-range:U+0102-0103,U+0110-0111,U+0128-0129,U+0168-0169,U+01A0-01A1,U+01AF-01B0,U+0300-0301,U+0303-0304,U+0308-0309,U+0323,U+0329,U+1EA0-1EF9,U+20AB}`;
---

<!doctype html>
<html lang="vi">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#fbf6f4" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={new URL('/assets/portrait.webp', Astro.site)} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href={fontLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={fontVi} as="font" type="font/woff2" crossorigin />
    <style is:inline set:html={fontCss}></style>
    <script is:inline>
      // Bật lớp chuyển động chỉ khi có JS và người xem không chọn giảm chuyển động.
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) document.documentElement.classList.add('motion');
    </script>
  </head>
  <body data-page={page}>
    <a class="skip" href="#main">Bỏ qua menu</a>
    <Nav page={page} />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <script>
      import '../scripts/core';
    </script>
  </body>
</html>

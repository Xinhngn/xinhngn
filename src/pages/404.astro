---
import Base from '../layouts/Base.astro';
---

<Base title="Không tìm thấy · XINH.OS">
  <section class="wrap nf">
    <p class="mono accent">Lỗi 404</p>
    <h1 class="mega">Ơ<span class="accent">.</span></h1>
    <p class="lead">Trang này không có trong XINH.OS.</p>
    <a class="btn" href="/">Về trang chủ <span class="arr">→</span></a>
  </section>
</Base>

<style>
  .nf { min-height: 80svh; display: grid; align-content: center; gap: 20px; padding-top: 100px; }
  .nf .btn { justify-self: start; }
</style>

---
import Base from '../../layouts/Base.astro';
import { CASES, JOBS, kindName, type Case } from '../../data/work';

export function getStaticPaths() {
  return CASES.map((c, i) => ({ params: { slug: c.slug }, props: { c, next: CASES[(i + 1) % CASES.length], n: i + 1 } }));
}

interface Props { c: Case; next: Case; n: number }
const { c, next, n } = Astro.props;
const jobs = JOBS.filter((j) => j.caseSlug === c.slug);
const kinds = [...new Set(jobs.flatMap((j) => j.ty))].filter((k) => k !== 'tbd');
const blocks = [
  { k: 'Bối cảnh', v: c.context },
  { k: 'Vai trò', v: c.role },
  { k: 'Xinh đã làm', v: c.me },
  { k: 'Phần của team', v: c.team },
].filter((b) => b.v);
---

<Base page="case" title={`${c.brand} · ${c.title} · XINH.OS`} description={`${c.brand}: ${c.tagline} ${c.outcome}`}>
  <article class="case">
    <header class="wrap case__head">
      <p class="case__crumbs mono"><a href="/du-an/">Dự án</a> / <span>0{n}</span></p>
      <div class="case__tags">
        <span class="pill pill--accent">{c.brand}</span>
        {c.period && <span class="pill">{c.period}</span>}
        {kinds.map((k) => <span class="pill">{kindName(k)}</span>)}
      </div>
      <h1 class="h1 case__title">{c.title}</h1>
      <p class="case__tag it">{c.tagline}</p>
    </header>

    <div class="wrap case__brand" aria-hidden="true"><span>{c.brand}</span></div>

    <section class="wrap case__grid">
      {blocks.map((b) => (
        <div class="case__block" data-reveal>
          <p class="mono accent">{b.k}</p>
          <p>{b.v}</p>
        </div>
      ))}
      {c.lesson && (
        <div class="case__block case__block--wide" data-reveal>
          <p class="mono accent">Bài học</p>
          <p class="it case__lesson">{c.lesson}</p>
        </div>
      )}
    </section>

    <section class="wrap case__res" data-reveal>
      <p class="mono accent">Kết quả</p>
      <div class="case__nums">
        {c.results.map((r) => (
          <div class="case__num"><b>{r.b}</b><span>{r.l}</span></div>
        ))}
      </div>
      <p class="case__out">{c.outcome}</p>
      {c.source && <p class="mono muted">{c.source}</p>}
    </section>

    {c.journey.length > 0 && (
      <section class="wrap case__journey">
        <p class="mono accent">Các hạng mục</p>
        <ol>{c.journey.map((j, i) => <li><span class="mono muted">0{i + 1}</span>{j}</li>)}</ol>
      </section>
    )}

    <section class="wrap case__media" aria-label="Ảnh thành phẩm">
      {[1, 2, 3].map((i) => (
        <figure class="case__ph"><span class="mono">Ảnh thành phẩm {i}</span></figure>
      ))}
    </section>

    <a class="case__next" href={`/du-an/${next.slug}/`}>
      <span class="wrap">
        <span class="mono">Case tiếp theo</span>
        <span class="case__next-b">{next.brand} <span class="arr">→</span></span>
      </span>
    </a>
  </article>
</Base>

<style>
  .case__head { padding-top: clamp(110px, 16vh, 160px); display: grid; gap: 20px; }
  .case__crumbs a { color: var(--ink-2); }
  .case__crumbs a:hover { color: var(--accent); }
  .case__tags { display: flex; flex-wrap: wrap; gap: 6px; }
  .case__title { max-width: 16ch; }
  .case__tag { font-size: clamp(22px, 2.4vw, 32px); color: var(--ink-2); }
  .case__brand { overflow: hidden; margin-top: clamp(28px, 4vw, 48px); }
  .case__brand span { display: block; font-size: clamp(72px, 16vw, 260px); font-weight: 800; letter-spacing: -0.06em; line-height: 0.82; color: var(--accent); text-wrap: balance; }

  .case__grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: clamp(16px, 2.4vw, 32px); padding-top: clamp(40px, 6vw, 72px); margin-top: 24px; border-top: 1px solid var(--line); }
  .case__block { display: grid; gap: 10px; align-content: start; }
  .case__block--wide { grid-column: 1 / -1; }
  .case__lesson { font-size: clamp(22px, 2.2vw, 30px); max-width: 32ch; line-height: 1.3; }

  .case__res { display: grid; gap: 18px; margin-top: clamp(56px, 8vw, 96px); padding: clamp(24px, 3vw, 40px); border-radius: calc(var(--r) + 6px); background: var(--glass-bg); border: 1px solid var(--glass-border); box-shadow: var(--glass-shadow); -webkit-backdrop-filter: blur(var(--glass-blur)) saturate(1.4); backdrop-filter: blur(var(--glass-blur)) saturate(1.4); }
  .case__nums { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 20px; }
  .case__num { display: grid; gap: 4px; border-top: 1px solid var(--line); padding-top: 12px; }
  .case__num b { font-size: clamp(34px, 4vw, 60px); letter-spacing: -0.04em; line-height: 1; color: var(--accent); }
  .case__num span { color: var(--ink-2); font-size: 15px; }
  .case__out { font-weight: 600; max-width: 60ch; }

  .case__journey { margin-top: clamp(48px, 6vw, 80px); display: grid; gap: 12px; }
  .case__journey ol { border-top: 1px solid var(--line); }
  .case__journey li { display: flex; gap: 16px; align-items: baseline; padding: 14px 0; border-bottom: 1px solid var(--line); font-size: clamp(18px, 1.6vw, 22px); font-weight: 600; }

  .case__media { display: grid; grid-template-columns: 2fr 1fr; gap: 12px; margin-top: clamp(48px, 6vw, 80px); }
  .case__ph { margin: 0; display: grid; place-items: center; min-height: 220px; border-radius: var(--r); border: 2px dashed rgb(192 24 90 / 0.35); background: rgb(255 253 249 / 0.6); color: var(--accent); }
  .case__ph:first-child { grid-row: span 2; min-height: 460px; }

  .case__next { display: block; margin-top: clamp(72px, 10vw, 140px); padding: clamp(40px, 6vw, 80px) 0; background: var(--accent); color: var(--accent-ink); }
  .case__next .wrap { display: grid; gap: 8px; }
  .case__next-b { font-size: clamp(44px, 8vw, 120px); font-weight: 800; letter-spacing: -0.045em; line-height: 0.9; }
  .case__next .arr { display: inline-block; transition: transform var(--t-fast) var(--ease); }
  .case__next:hover .arr { transform: translateX(12px); }

  @media (max-width: 900px) {
    .case__grid { grid-template-columns: 1fr 1fr; }
    .case__media { grid-template-columns: 1fr; }
    .case__ph:first-child { grid-row: auto; min-height: 260px; }
  }
  @media (max-width: 560px) { .case__grid { grid-template-columns: 1fr; } }
</style>

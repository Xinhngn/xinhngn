---
import Base from '../../layouts/Base.astro';
import { CASES, JOBS, kindName, type Case } from '../../data/work';

export function getStaticPaths() {
  return CASES.map((c, i) => ({ params: { slug: c.slug }, props: { c, next: CASES[(i + 1) % CASES.length] } }));
}

interface Props { c: Case; next: Case }
const { c, next } = Astro.props;
const jobs = JOBS.filter((j) => j.caseSlug === c.slug);
const kinds = [...new Set(jobs.flatMap((j) => j.ty))].filter((k) => k !== 'tbd');
---

<Base page="case" title={`${c.brand} · ${c.title} · XINH.OS`} description={`${c.brand}: ${c.tagline} ${c.outcome}`}>
  <article class="case">
    <header class="wrap case__head">
      <p class="case__crumbs small"><a href="/du-an/">Dự án</a> <span aria-hidden="true">/</span> {c.brand}</p>
      <h1 class="case__brand">{c.brand}</h1>
      <div class="case__intro">
        <div>
          <p class="case__title">{c.title}</p>
          {c.tagline !== c.title && c.tagline !== `${c.title}.` && <p class="lead soft">{c.tagline}</p>}
        </div>
        <ul class="case__tags small">
          {c.period && <li>{c.period}</li>}
          {kinds.map((k) => <li>{kindName(k)}</li>)}
        </ul>
      </div>
    </header>

    <section class="wrap case__split" aria-label="Bối cảnh và vai trò">
      <div class="case__block" data-rv>
        <h2 class="case__k">Bối cảnh</h2>
        <p class="state">{c.context}</p>
      </div>
      {c.role && (
        <div class="case__block" data-rv style="--d:1">
          <h2 class="case__k">Vai trò</h2>
          <p class="state">{c.role}</p>
        </div>
      )}
    </section>

    <section class="wrap case__who" aria-label="Phần Xinh làm và phần của team">
      <div class="case__me" data-rv>
        <h2 class="case__k">Xinh đã làm</h2>
        <p>{c.me}</p>
      </div>
      <div class="case__team" data-rv style="--d:1">
        <h2 class="case__k">Phần của team</h2>
        <p>{c.team || 'Đang cập nhật.'}</p>
      </div>
    </section>

    {c.lesson && (
      <section class="wrap case__lesson" data-rv>
        <h2 class="case__k">Bài học</h2>
        <p class="case__lesson-t">{c.lesson}</p>
      </section>
    )}

    <section class="case__res">
      <div class="wrap">
        <h2 class="case__k">Kết quả</h2>
        <div class="case__nums">
          {c.results.map((r, i) => (
            <div class="case__num" data-rv style={`--d:${i}`}><b>{r.b}</b><span>{r.l}</span></div>
          ))}
        </div>
        <p class="case__out">{c.outcome}</p>
        {c.source && <p class="small soft">{c.source}</p>}
      </div>
    </section>

    {c.journey.length > 0 && (
      <section class="wrap case__journey">
        <h2 class="case__k">Các hạng mục</h2>
        <ul>{c.journey.map((j, i) => <li data-rv style={`--d:${i}`}>{j}</li>)}</ul>
      </section>
    )}

    <section class="wrap case__media" aria-label="Ảnh thành phẩm">
      {[1, 2, 3].map((i) => (
        <figure class="case__ph"><figcaption class="small">Ảnh thành phẩm {i} · đang chờ ảnh được phép chia sẻ</figcaption></figure>
      ))}
    </section>

    <a class="case__next" href={`/du-an/${next.slug}/`}>
      <span class="wrap case__next-in">
        <span class="small">Case tiếp theo</span>
        <span class="case__next-b">{next.brand} <span class="arr" aria-hidden="true">→</span></span>
      </span>
    </a>
  </article>
</Base>

<style>
  .case__head { padding-top: clamp(120px, 18vh, 200px); display: grid; gap: clamp(20px, 3vw, 40px); }
  .case__crumbs { display: flex; gap: 8px; font-weight: 600; }
  .case__crumbs a { color: var(--acc); }
  .case__brand { font-size: clamp(76px, 17vw, 320px); letter-spacing: -0.06em; line-height: 0.8; animation: up 1s var(--ease) both; }
  .case__intro { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 24px; align-items: end; }
  .case__title { font-size: clamp(30px, 3.6vw, 64px); font-weight: 700; letter-spacing: -0.04em; line-height: 1; margin-bottom: 14px; max-width: 18ch; }
  .case__tags { display: flex; flex-wrap: wrap; gap: 6px; justify-content: end; }
  .case__tags li { padding: 7px 14px; border-radius: 999px; background: var(--bg-2); font-weight: 600; }
  @keyframes up { from { opacity: 0; transform: translateY(40px); } to { opacity: 1; transform: none; } }

  .case__k { font-size: 17px; font-weight: 700; letter-spacing: -0.01em; color: var(--acc); margin-bottom: 14px; line-height: 1.2; }
  .case__split { display: grid; grid-template-columns: 1.3fr 1fr; gap: clamp(28px, 5vw, 96px); margin-top: var(--sec); }
  .case__state { max-width: 26ch; }
  .case__who { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; margin-top: clamp(64px, 8vw, 120px); }
  .case__me, .case__team { padding: clamp(26px, 3vw, 48px); border-radius: 30px; font-size: clamp(19px, 1.5vw, 23px); line-height: 1.45; }
  .case__me { background: var(--blush); }
  .case__team { background: var(--bg-2); }
  .case__lesson { margin-top: clamp(64px, 8vw, 120px); }
  .case__lesson-t { font-size: clamp(32px, 4vw, 68px); font-weight: 650; letter-spacing: -0.04em; line-height: 1.04; max-width: 22ch; }

  .case__res { margin: clamp(80px, 10vw, 160px) clamp(6px, 1vw, 14px) 0; padding-block: clamp(56px, 8vw, 120px); border-radius: 40px; background: var(--peach); }
  .case__nums { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: clamp(20px, 3vw, 48px); margin-top: 12px; }
  .case__num { display: grid; gap: 8px; }
  .case__num b { font-size: clamp(54px, 7vw, 128px); letter-spacing: -0.05em; line-height: 0.9; color: var(--acc); font-weight: 780; }
  .case__num span { font-size: 18px; font-weight: 550; }
  .case__out { font-size: clamp(20px, 1.6vw, 26px); font-weight: 600; max-width: 46ch; margin-top: clamp(28px, 4vw, 56px); margin-bottom: 10px; }

  .case__journey { margin-top: clamp(64px, 8vw, 128px); }
  .case__journey ul { display: flex; flex-wrap: wrap; gap: 10px; }
  .case__journey li { padding: 16px 24px; border-radius: 999px; background: var(--bg-2); font-size: clamp(19px, 1.6vw, 26px); font-weight: 650; letter-spacing: -0.02em; }

  .case__media { display: grid; grid-template-columns: 2fr 1fr; gap: 14px; margin-top: clamp(64px, 8vw, 128px); }
  .case__ph { display: grid; place-items: end start; padding: 22px; min-height: 240px; border-radius: 30px; background: var(--bg-2); color: var(--ink-2); font-weight: 550; }
  .case__ph:first-child { grid-row: span 2; min-height: 500px; background: var(--blush); }

  .case__next { display: block; margin-top: var(--sec); padding-block: clamp(48px, 7vw, 110px) clamp(64px, 9vw, 140px); background: var(--acc); color: var(--acc-ink); border-radius: 40px 40px 0 0; }
  .case__next-in { display: grid; gap: 10px; }
  .case__next-b { font-size: clamp(56px, 10vw, 190px); font-weight: 800; letter-spacing: -0.055em; line-height: 0.86; }
  .case__next .arr { display: inline-block; transition: transform 0.5s var(--ease); }
  .case__next:hover .arr { transform: translateX(20px); }
  :global(body[data-page='case'] .foot) { border-radius: 0; }

  @media (max-width: 860px) {
    .case__intro, .case__split, .case__who, .case__media { grid-template-columns: 1fr; }
    .case__tags { justify-content: start; }
    .case__ph:first-child { grid-row: auto; min-height: 280px; }
    .case__res { border-radius: 28px; }
  }
</style>

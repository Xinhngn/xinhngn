---
import Base from '../../layouts/Base.astro';
import { JOBS, KINDS, CLIENTS, clientName, kindName } from '../../data/work';

const byKind = KINDS.map((k) => ({ ...k, count: JOBS.filter((j) => j.ty.includes(k.k)).length }));
const byClient = CLIENTS.map((c) => ({ ...c, count: JOBS.filter((j) => j.c === c.k).length }));
const tones = ['t-blush', 't-peach', 't-acc', 't-bg2'];
const toneOf = (c: string) => tones[CLIENTS.findIndex((x) => x.k === c) % tones.length];
---

<Base page="work" title="Dự án · XINH.OS" description={`${JOBS.length} chiến dịch Xinh đã tham gia, cùng ${CLIENTS.length} khách hàng. Lọc theo tính chất hoặc theo khách hàng.`}>
  <section class="work wrap">
    <header class="work__head">
      <h1 class="work__t">Dự án</h1>
      <p class="lead">{JOBS.length} chiến dịch, {CLIENTS.length} khách hàng. Kết quả của team được ghi rõ là của team.</p>
    </header>

    <div class="work__layout" data-filter>
      <aside class="work__side" aria-label="Bộ lọc">
        <div class="work__tabs glass" role="tablist">
          <button class="is-on" role="tab" aria-selected="true" data-mode="kind">Theo tính chất</button>
          <button role="tab" aria-selected="false" data-mode="client">Theo khách hàng</button>
        </div>
        <ul class="work__opts" data-for="kind">
          <li><button class="opt is-on" data-f="all">Tất cả <span>{JOBS.length}</span></button></li>
          {byKind.map((k) => <li><button class="opt" data-f={k.k}>{k.t} <span>{k.count}</span></button></li>)}
        </ul>
        <ul class="work__opts" data-for="client" hidden>
          <li><button class="opt is-on" data-f="all">Tất cả <span>{JOBS.length}</span></button></li>
          {byClient.map((c) => <li><button class="opt" data-f={c.k}>{c.n} <span>{c.count}</span></button></li>)}
        </ul>
        <p class="small soft" aria-live="polite" data-count>Đang hiện {JOBS.length} chiến dịch</p>
      </aside>

      <ul class="work__grid">
        {JOBS.map((j) => {
          const meta = j.ty.map(kindName).join(' · ') + (j.y ? ` · ${j.y}` : '');
          return (
            <li class="card" data-kind={j.ty.join(' ')} data-client={j.c}>
              {j.caseSlug ? (
                <a class="card__in" href={`/du-an/${j.caseSlug}/`}>
                  <span class:list={['card__cover', toneOf(j.c)]}>
                    <span class="card__client">{clientName(j.c)}</span>
                    <span class="card__go small">Xem case →</span>
                  </span>
                  <span class="card__name">{j.n}</span>
                  <span class="small soft">{meta}</span>
                </a>
              ) : (
                <div class="card__in">
                  <span class:list={['card__cover', toneOf(j.c)]}><span class="card__client">{clientName(j.c)}</span></span>
                  <span class="card__name">{j.n}</span>
                  <span class="small soft">{meta}</span>
                  {(j.role || j.me || j.out) && (
                    <span class="card__more small">
                      {j.role && <span><b>Vai trò:</b> {j.role}</span>}
                      {j.me && <span>{j.me}</span>}
                      {j.out && <span><b>{j.out}</b></span>}
                    </span>
                  )}
                </div>
              )}
            </li>
          );
        })}
      </ul>
    </div>
  </section>
</Base>

<script>
  const root = document.querySelector<HTMLElement>('[data-filter]');
  if (root) {
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let mode: 'kind' | 'client' = 'kind';
    const cards = Array.from(root.querySelectorAll<HTMLElement>('.card'));
    const count = root.querySelector('[data-count]')!;
    const apply = (f: string) => {
      let n = 0, k = 0;
      cards.forEach((c) => {
        const hit = f === 'all' || (mode === 'kind' ? (c.dataset.kind || '').split(' ').includes(f) : c.dataset.client === f);
        if (hit) {
          n++;
          const was = c.hidden;
          c.hidden = false;
          if (was && !reduce) c.animate([{ opacity: 0, transform: 'translateY(24px) scale(.96)' }, { opacity: 1, transform: 'none' }], { duration: 520, delay: k++ * 35, easing: 'cubic-bezier(.22,1,.36,1)', fill: 'backwards' });
        } else c.hidden = true;
      });
      count.textContent = `Đang hiện ${n} chiến dịch`;
    };
    root.querySelectorAll<HTMLButtonElement>('[data-mode]').forEach((b) => b.addEventListener('click', () => {
      mode = b.dataset.mode as typeof mode;
      root.querySelectorAll<HTMLButtonElement>('[data-mode]').forEach((x) => { const on = x === b; x.classList.toggle('is-on', on); x.setAttribute('aria-selected', String(on)); });
      root.querySelectorAll<HTMLElement>('[data-for]').forEach((u) => (u.hidden = u.dataset.for !== mode));
      root.querySelectorAll('.opt').forEach((o) => o.classList.toggle('is-on', (o as HTMLElement).dataset.f === 'all'));
      apply('all');
    }));
    root.querySelectorAll<HTMLButtonElement>('.opt').forEach((o) => o.addEventListener('click', () => {
      o.closest('ul')!.querySelectorAll('.opt').forEach((x) => x.classList.toggle('is-on', x === o));
      apply(o.dataset.f!);
    }));
  }
</script>

<style>
  .work { padding-top: clamp(120px, 18vh, 200px); padding-bottom: var(--sec); }
  .work__head { display: grid; grid-template-columns: 1fr auto; align-items: end; gap: 24px; margin-bottom: clamp(40px, 6vw, 96px); }
  .work__t { font-size: var(--t-mega); letter-spacing: -0.06em; line-height: 0.8; }
  .work__layout { display: grid; grid-template-columns: 250px 1fr; gap: clamp(20px, 3vw, 48px); align-items: start; }
  .work__side { position: sticky; top: 96px; display: grid; gap: 18px; }
  .work__tabs { display: flex; padding: 4px; border-radius: 999px; }
  .work__tabs button { flex: 1; padding: 9px 10px; border-radius: 999px; font-size: 14px; font-weight: 600; transition: background var(--t-fast), color var(--t-fast); }
  .work__tabs button.is-on { background: var(--ink); color: var(--bg); }
  .work__opts { display: grid; gap: 2px; }
  .opt { display: flex; justify-content: space-between; width: 100%; gap: 10px; padding: 9px 14px; border-radius: 14px; font-size: 16px; font-weight: 550; text-align: left; transition: background var(--t-fast), color var(--t-fast); }
  .opt span { color: var(--ink-3); font-variant-numeric: tabular-nums; }
  .opt:hover { background: var(--bg-2); }
  .opt.is-on { background: var(--acc); color: var(--acc-ink); }
  .opt.is-on span { color: inherit; }

  .work__grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); gap: clamp(14px, 1.6vw, 24px); }
  .card__in { display: grid; gap: 8px; align-content: start; }
  .card__cover { position: relative; display: flex; flex-direction: column; justify-content: space-between; aspect-ratio: 4 / 3.4; padding: 18px; border-radius: 24px; overflow: hidden; transition: transform 0.6s var(--ease), border-radius 0.6s var(--ease); }
  a.card__in:hover .card__cover { transform: translateY(-6px) rotate(-1deg); border-radius: 34px; }
  .card__client { font-size: clamp(30px, 2.8vw, 44px); font-weight: 780; letter-spacing: -0.045em; line-height: 0.92; }
  .card__go { align-self: flex-end; font-weight: 650; opacity: 0; transform: translateY(8px); transition: opacity 0.3s, transform 0.4s var(--ease); }
  a.card__in:hover .card__go, a.card__in:focus-visible .card__go { opacity: 1; transform: none; }
  .t-blush { background: var(--blush); }
  .t-peach { background: var(--peach); }
  .t-acc { background: var(--acc); color: var(--acc-ink); }
  .t-bg2 { background: var(--bg-2); color: var(--acc); }
  .card__name { font-weight: 700; font-size: 19px; line-height: 1.25; letter-spacing: -0.015em; }
  .card__more { display: grid; gap: 6px; padding-top: 4px; }
  @media (max-width: 860px) {
    .work__head { grid-template-columns: 1fr; }
    .work__layout { grid-template-columns: 1fr; }
    .work__side { position: static; }
    .work__opts { display: flex; flex-wrap: wrap; gap: 4px; }
    .opt { width: auto; background: var(--bg-2); border-radius: 999px; }
    .work__grid { grid-template-columns: repeat(auto-fill, minmax(155px, 1fr)); }
  }
</style>

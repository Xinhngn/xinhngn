---
import Base from '../../layouts/Base.astro';
import { JOBS, KINDS, CLIENTS, clientName, kindName } from '../../data/work';

const byKind = KINDS.map((k) => ({ ...k, count: JOBS.filter((j) => j.ty.includes(k.k)).length }));
const byClient = CLIENTS.map((c) => ({ ...c, count: JOBS.filter((j) => j.c === c.k).length }));
const tones = ['t-accent', 't-blush', 't-paper', 't-blush2'];
const toneOf = (c: string) => tones[CLIENTS.findIndex((x) => x.k === c) % tones.length];
---

<Base page="work" title="Dự án · XINH.OS" description={`${JOBS.length} chiến dịch Xinh đã tham gia, cùng ${CLIENTS.length} khách hàng. Lọc theo tính chất hoặc theo khách hàng.`}>
  <section class="work wrap">
    <header class="work__head">
      <h1 class="h1">Dự án</h1>
      <p class="lead">Các chiến dịch Xinh đã tham gia. Kết quả của team được ghi rõ là của team.</p>
    </header>

    <div class="work__layout" data-filter>
      <aside class="work__side" aria-label="Bộ lọc">
        <div class="work__tabs" role="tablist">
          <button class="pill pill--dark" role="tab" aria-selected="true" data-mode="kind">Theo tính chất</button>
          <button class="pill" role="tab" aria-selected="false" data-mode="client">Theo khách hàng</button>
        </div>
        <ul class="work__opts" data-for="kind">
          <li><button class="opt is-on" data-f="all">Tất cả <span>({JOBS.length})</span></button></li>
          {byKind.map((k) => <li><button class="opt" data-f={k.k}>{k.t} <span>({k.count})</span></button></li>)}
        </ul>
        <ul class="work__opts" data-for="client" hidden>
          <li><button class="opt is-on" data-f="all">Tất cả <span>({JOBS.length})</span></button></li>
          {byClient.map((c) => <li><button class="opt" data-f={c.k}>{c.n} <span>({c.count})</span></button></li>)}
        </ul>
      </aside>

      <ul class="work__grid">
        {JOBS.map((j) => (
          <li class="card" data-kind={j.ty.join(' ')} data-client={j.c}>
            {j.caseSlug ? (
              <a class="card__in" href={`/du-an/${j.caseSlug}/`}>
                <span class:list={['card__cover', toneOf(j.c)]}><span class="card__client">{clientName(j.c)}</span></span>
                <span class="card__name">{j.n}</span>
                <span class="card__meta mono">{j.ty.map(kindName).join(' · ')}{j.y && ` · ${j.y}`}</span>
                <span class="card__go mono">Xem case →</span>
              </a>
            ) : (
              <details class="card__in">
                <summary>
                  <span class:list={['card__cover', toneOf(j.c)]}><span class="card__client">{clientName(j.c)}</span></span>
                  <span class="card__name">{j.n}</span>
                  <span class="card__meta mono">{j.ty.map(kindName).join(' · ')}{j.y && ` · ${j.y}`}</span>
                </summary>
                <div class="card__more">
                  {j.role && <p><span class="mono muted">Vai trò</span> {j.role}</p>}
                  {j.me && <p>{j.me}</p>}
                  {j.out && <p class="it">{j.out}</p>}
                </div>
              </details>
            )}
          </li>
        ))}
      </ul>
    </div>
  </section>
</Base>

<script>
  const root = document.querySelector<HTMLElement>('[data-filter]');
  if (root) {
    let mode: 'kind' | 'client' = 'kind';
    const cards = Array.from(root.querySelectorAll<HTMLElement>('.card'));
    const apply = (f: string) => {
      cards.forEach((c, i) => {
        const hit = f === 'all' || (mode === 'kind' ? (c.dataset.kind || '').split(' ').includes(f) : c.dataset.client === f);
        if (hit && c.hidden) { c.hidden = false; c.animate([{ opacity: 0, transform: 'translateY(16px)' }, { opacity: 1, transform: 'none' }], { duration: 420, delay: i * 18, easing: 'cubic-bezier(.22,1,.36,1)', fill: 'backwards' }); }
        else if (!hit) c.hidden = true;
      });
    };
    root.querySelectorAll<HTMLButtonElement>('[data-mode]').forEach((b) => b.addEventListener('click', () => {
      mode = b.dataset.mode as typeof mode;
      root.querySelectorAll<HTMLButtonElement>('[data-mode]').forEach((x) => { const on = x === b; x.classList.toggle('pill--dark', on); x.setAttribute('aria-selected', String(on)); });
      root.querySelectorAll<HTMLElement>('[data-for]').forEach((u) => (u.hidden = u.dataset.for !== mode));
      root.querySelectorAll('.opt').forEach((o) => o.classList.toggle('is-on', (o as HTMLElement).dataset.f === 'all'));
      apply('all');
    }));
    root.querySelectorAll<HTMLButtonElement>('.opt').forEach((o) => o.addEventListener('click', () => {
      o.closest('ul')!.querySelectorAll('.opt').forEach((x) => x.classList.toggle('is-on', x === o));
      apply(o.dataset.f!);
    }));
  }
</script>

<style>
  .work { padding-top: clamp(110px, 16vh, 160px); padding-bottom: 120px; }
  .work__head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-end; gap: 20px; margin-bottom: 48px; }
  .work__layout { display: grid; grid-template-columns: 220px 1fr; gap: clamp(20px, 3vw, 40px); align-items: start; }
  .work__side { position: sticky; top: 90px; display: grid; gap: 16px; }
  .work__tabs { display: flex; flex-wrap: wrap; gap: 6px; }
  .work__tabs .pill { cursor: pointer; }
  .work__opts { display: grid; gap: 2px; }
  .opt { display: inline-flex; gap: 6px; padding: 6px 10px; border-radius: 999px; font-family: var(--f-mono); font-size: 12px; letter-spacing: 0.03em; text-transform: uppercase; text-align: left; transition: background var(--t-fast); }
  .opt span { color: var(--ink-3); }
  .opt:hover { background: var(--paper-2); }
  .opt.is-on { background: var(--accent); color: var(--accent-ink); }
  .opt.is-on span { color: inherit; opacity: 0.8; }

  .work__grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(230px, 1fr)); gap: clamp(12px, 1.6vw, 20px); }
  .card__in { display: grid; gap: 8px; }
  details.card__in summary { display: grid; gap: 8px; cursor: pointer; list-style: none; }
  details.card__in summary::-webkit-details-marker { display: none; }
  .card__cover { display: flex; align-items: flex-end; aspect-ratio: 4 / 3; padding: 16px; border-radius: var(--r); overflow: hidden; transition: transform 0.5s var(--ease), border-radius 0.5s var(--ease); }
  .card__in:hover .card__cover, details[open] .card__cover { transform: translateY(-4px); border-radius: calc(var(--r) + 8px); }
  .card__client { font-size: clamp(26px, 2.6vw, 38px); font-weight: 800; letter-spacing: -0.035em; line-height: 0.95; }
  .t-accent { background: var(--accent); color: var(--accent-ink); }
  .t-blush { background: var(--blush); color: var(--ink); }
  .t-paper { background: var(--paper-3); color: var(--ink); }
  .t-blush2 { background: var(--glass-bg-strong); color: var(--accent); border: 1px solid var(--glass-border); box-shadow: var(--glass-shadow); }
  .card__name { font-weight: 700; font-size: 17px; line-height: 1.3; }
  .card__meta { color: var(--ink-3); }
  .card__go { color: var(--accent); }
  .card__more { display: grid; gap: 8px; padding: 12px 2px 4px; font-size: 15px; }
  @media (max-width: 820px) {
    .work__layout { grid-template-columns: 1fr; }
    .work__side { position: static; }
    .work__opts { display: flex; flex-wrap: wrap; gap: 4px; }
    .work__grid { grid-template-columns: repeat(auto-fill, minmax(160px, 1fr)); }
  }
</style>

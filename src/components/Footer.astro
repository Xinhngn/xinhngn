---
import { CONTACT, FINISH, TARGET_ROLES } from '../data/site';
const channels = [
  { k: 'Gọi', v: CONTACT.phoneLabel, href: `tel:${CONTACT.phone}` },
  { k: 'Zalo', v: CONTACT.phoneLabel, href: `https://zalo.me/${CONTACT.zalo}` },
  { k: 'Email', v: CONTACT.email, href: `mailto:${CONTACT.email}?subject=${encodeURIComponent('Say hi Xinh')}` },
  { k: 'LinkedIn', v: 'xinh-nguyen-exploremore', href: `https://www.linkedin.com/in/${CONTACT.linkedin}` },
  { k: 'CV', v: 'XinhNguyen-CV.pdf', href: CONTACT.cv },
];
---

<footer class="foot" id="lien-he" data-foot>
  <div class="wrap foot__in">
    <p class="foot__lead state">{FINISH.body}</p>

    <ul class="foot__ch">
      {channels.map((c) => (
        <li>
          <a href={c.href} target={c.href.startsWith('http') || c.k === 'CV' ? '_blank' : undefined} rel={c.href.startsWith('http') ? 'noopener' : undefined}>
            <span class="soft small">{c.k}</span>
            <span class="foot__v">{c.v}</span>
            <span class="foot__arr" aria-hidden="true">↗</span>
          </a>
        </li>
      ))}
    </ul>

    <p class="foot__say" aria-label="say hi!">
      {'say hi!'.split('').map((ch, i) => <span style={`--i:${i}`}>{ch === ' ' ? ' ' : ch}</span>)}
    </p>

    <div class="foot__bar small">
      <p>Vai trò mục tiêu: <span class="foot__role" data-roles={JSON.stringify(TARGET_ROLES)}>{TARGET_ROLES[0]}</span></p>
      <p class="foot__time">TP.HCM <time data-clock>--:--</time></p>
      <p>© 2026 Xinh Nguyễn · XINH.OS</p>
    </div>
  </div>
</footer>

<style>
  .foot { background: var(--blush); border-radius: 40px 40px 0 0; overflow: clip; }
  .foot__in { display: grid; gap: clamp(36px, 5vw, 72px); padding-top: clamp(80px, 11vw, 180px); padding-bottom: 24px; }
  .foot__lead { max-width: 30ch; font-weight: 600; }
  .foot__ch { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 10px; }
  .foot__ch a { position: relative; display: grid; gap: 6px; min-height: 120px; align-content: end; padding: 20px; border-radius: 22px; background: var(--bg); transition: background var(--t-fast), color var(--t-fast), transform 0.4s var(--ease); }
  .foot__ch a:hover { background: var(--acc); color: var(--acc-ink); transform: translateY(-4px); }
  .foot__ch a:hover .soft { color: inherit; opacity: 0.8; }
  .foot__v { font-weight: 650; font-size: 18px; letter-spacing: -0.01em; overflow-wrap: anywhere; }
  .foot__arr { position: absolute; right: 18px; top: 14px; font-size: 22px; }
  .foot__say { display: flex; font-size: clamp(110px, 31vw, 600px); line-height: 0.78; letter-spacing: -0.065em; white-space: nowrap; margin-left: -0.04em; font-weight: 800; color: var(--acc); margin-top: clamp(20px, 4vw, 60px); user-select: none; }
  .foot__say span { display: inline-block; }
  .foot__bar { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 10px 24px; font-weight: 500; }
  .foot__role { font-weight: 700; color: var(--acc); }
  .foot__time { font-variant-numeric: tabular-nums; }
  @media (max-width: 960px) { .foot__ch { grid-template-columns: 1fr 1fr; } .foot__ch li:nth-child(3) { grid-column: 1 / -1; } }
  @media (max-width: 860px) { .foot { border-radius: 28px 28px 0 0; } }
</style>

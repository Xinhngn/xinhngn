---
interface Props { page: string }
const { page } = Astro.props;
const links = [
  { href: '/du-an/', t: 'Dự án', on: page === 'work' || page === 'case' },
  { href: '/#ho-so', t: 'Hồ sơ' },
  { href: '/#nang-luc', t: 'Năng lực' },
  { href: '/#lien-he', t: 'Liên hệ' },
];
---

<header class="nav" data-nav>
  <div class="nav__in">
    <a class="nav__mark" href="/" aria-label="XINH.OS, về trang chủ">XINH<span class="acc">.</span>OS</a>

    <nav class="nav__links glass" aria-label="Chính">
      {links.map((l) => <a href={l.href} aria-current={l.on ? 'page' : undefined}>{l.t}</a>)}
    </nav>

    <div class="nav__end">
      <p class="nav__time small"><span class="dot" aria-hidden="true"></span><span>TP.HCM <time data-clock>--:--</time></span></p>
      <a class="btn nav__cta" href="/#lien-he">Say hi</a>
    </div>

    <details class="nav__menu">
      <summary class="glass">Menu</summary>
      <div class="nav__sheet glass">
        {links.map((l) => <a href={l.href}>{l.t}</a>)}
        <a class="btn" href="/#lien-he">Say hi</a>
      </div>
    </details>
  </div>
</header>

<style>
  .nav { position: fixed; inset: 0 0 auto; z-index: 50; padding: 14px var(--gut); pointer-events: none; transition: transform 0.5s var(--ease); }
  .nav.is-up { transform: translateY(-110%); }
  .nav__in { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 16px; }
  .nav__in > * { pointer-events: auto; }
  .nav__mark { font-weight: 800; font-size: 22px; letter-spacing: -0.04em; justify-self: start; }
  .nav__links { display: flex; gap: 2px; padding: 5px; border-radius: 999px; }
  .nav__links a { padding: 9px 16px; border-radius: 999px; font-size: 15px; font-weight: 550; transition: background var(--t-fast), color var(--t-fast); }
  .nav__links a:hover { background: rgb(255 255 255 / 0.8); }
  .nav__links a[aria-current] { background: var(--ink); color: var(--bg); }
  .nav__end { justify-self: end; display: flex; align-items: center; gap: 14px; }
  .nav__time { display: flex; align-items: center; gap: 8px; font-variant-numeric: tabular-nums; font-weight: 500; }
  .dot { width: 8px; height: 8px; border-radius: 50%; background: var(--acc); box-shadow: 0 0 0 0 rgb(201 31 85 / 0.5); animation: pulse 2.2s var(--ease) infinite; }
  @keyframes pulse { 70% { box-shadow: 0 0 0 9px rgb(201 31 85 / 0); } 100% { box-shadow: 0 0 0 0 rgb(201 31 85 / 0); } }
  .nav__cta { min-height: 42px; padding: 0 20px; font-size: 15px; }
  .nav__menu { display: none; justify-self: end; position: relative; }
  .nav__menu summary { list-style: none; cursor: pointer; padding: 10px 18px; border-radius: 999px; font-weight: 600; font-size: 15px; }
  .nav__menu summary::-webkit-details-marker { display: none; }
  .nav__sheet { position: absolute; right: 0; top: calc(100% + 8px); display: grid; gap: 4px; min-width: 220px; padding: 10px; border-radius: 22px; }
  .nav__sheet a:not(.btn) { padding: 12px 14px; border-radius: 14px; font-size: 20px; font-weight: 600; }
  .nav__sheet .btn { margin-top: 6px; justify-content: center; }
  @media (max-width: 860px) {
    .nav__in { grid-template-columns: 1fr auto; }
    .nav__links, .nav__end { display: none; }
    .nav__menu { display: block; }
  }
</style>

---
import { HERO } from '../data/site';
const faces = [
  { src: '/assets/xinh-hi.webp', alt: 'Xinh vẫy chào', w: 560, h: 840 },
  { src: '/assets/xinh-go.webp', alt: 'Xinh sẵn sàng lên đường', w: 640, h: 1138 },
  { src: '/assets/xinh-work.webp', alt: 'Xinh đang làm việc', w: 640, h: 853 },
  { src: '/assets/xinh-chill.webp', alt: 'Xinh nghỉ ngơi', w: 560, h: 840 },
];
---

<section class="hero" id="top">
  <canvas class="hero__field" data-field aria-hidden="true"></canvas>

  <div class="wrap hero__in">
    <div class="hero__top">
      <div class="hero__say">
        <p class="hero__hi">{HERO.hi}</p>
        <p class="hero__hint small soft" aria-hidden="true">Rê chuột để gỡ rối các đường nét</p>
      </div>
      <button class="hero__face glass" type="button" data-faces={JSON.stringify(faces)} aria-label="Đổi ảnh Xinh">
        <span class="hero__img">
          <img src={faces[0].src} alt={faces[0].alt} width={faces[0].w} height={faces[0].h} fetchpriority="high" decoding="async" data-face-img />
        </span>
        <span class="hero__cap small">Bấm đổi ảnh · <span data-face-n>1</span>/{faces.length}</span>
      </button>
    </div>

    <h1 class="hero__title">
      <span class="ln"><span style="--i:0">Xinh thích</span></span>
      <span class="ln"><span style="--i:1">làm chủ<span class="acc">.</span></span></span>
    </h1>

    <div class="hero__foot">
      <p class="lead">{HERO.sub}</p>
      <div class="hero__cta">
        <a class="btn" href="/du-an/" data-magnet>Xem dự án <span class="arr" aria-hidden="true">→</span></a>
        <a class="btn btn--ghost" href="#lien-he" data-magnet>Say hi</a>
      </div>
    </div>
  </div>
</section>

<style>
  .hero { position: relative; min-height: 100svh; display: flex; overflow: clip; background: var(--bg); }
  .hero__field { position: absolute; inset: 0; width: 100%; height: 100%; opacity: 0; transition: opacity 1.2s var(--ease); }
  .hero__field.is-on { opacity: 1; }
  .hero__in { position: relative; display: grid; grid-template-rows: 1fr auto auto; gap: clamp(18px, 2.4vw, 32px); padding-top: clamp(96px, 13vh, 140px); padding-bottom: clamp(24px, 4vh, 44px); min-height: 100svh; }
  .hero__top { display: flex; justify-content: space-between; align-items: flex-start; gap: 24px; }
  .hero__hi { font-size: var(--t-state); font-weight: 600; letter-spacing: -0.02em; color: var(--acc); animation: rise 0.9s var(--ease) both; }

  .hero__face { position: relative; display: grid; gap: 10px; width: clamp(150px, 15vw, 248px); padding: 8px 8px 12px; border-radius: 24px; transform: rotate(3deg); animation: drop 1.1s var(--ease) 0.25s backwards; }
  .hero__img img { transition: transform 0.7s var(--ease); }
  .hero__face:hover .hero__img img { transform: scale(1.06); }
  .hero__face:active .hero__img { transform: scale(0.97); }
  .hero__img { display: block; aspect-ratio: 4 / 5; border-radius: 17px; overflow: hidden; background: var(--blush); }
  .hero__img img { width: 100%; height: 100%; object-fit: cover; }
  .hero__face.is-swap .hero__img img { animation: swap 0.6s var(--ease); }
  .hero__cap { text-align: center; white-space: nowrap; font-size: 13px; font-weight: 500; font-variant-numeric: tabular-nums; }

  .hero__title { font-size: var(--t-mega); line-height: 0.86; letter-spacing: -0.055em; font-weight: 780; }
  .ln { display: block; overflow: clip; padding-bottom: 0.08em; margin-bottom: -0.08em; }
  .ln > span { display: block; animation: line 1s var(--ease) both; animation-delay: calc(0.08s + var(--i) * 0.09s); }

  .hero__foot { display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: end; gap: 20px 32px; animation: rise 0.9s var(--ease) 0.35s both; }
  .hero__cta { display: flex; gap: 10px; flex-wrap: wrap; }
  .hero__say { display: grid; gap: 6px; }
  .hero__hint { animation: rise 0.9s var(--ease) 0.5s both; }

  @keyframes line { from { transform: translateY(105%); } to { transform: none; } }
  @keyframes rise { from { opacity: 0; transform: translateY(18px); } to { opacity: 1; transform: none; } }
  @keyframes drop { from { opacity: 0; transform: translateY(-24px) rotate(-6deg); } to { opacity: 1; transform: rotate(3deg); } }
  @keyframes swap { from { transform: scale(1.12); filter: saturate(0.4); } to { transform: none; filter: none; } }

  @media (hover: none) { .hero__hint { display: none; } }
  @media (max-width: 760px) {
    .hero__in { grid-template-rows: auto 1fr auto; }
    .hero__top { flex-direction: column; }
    .hero__face { align-self: flex-end; width: 46vw; margin-top: -8px; }
    .hero__title { font-size: clamp(64px, 19.5vw, 120px); align-self: end; }
    .hero__foot { grid-template-columns: 1fr; }
  }
</style>

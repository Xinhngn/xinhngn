---
import { PROOF, BRANDS, SKILLS, MX } from '../data/site';
import { CASES, clientName } from '../data/work';

const groups = [
  { g: 'run', t: 'What I run' },
  { g: 'own', t: 'How far I take it' },
] as const;
// "Thể hiện qua": dự án có giá trị 1 (Xinh dẫn) hoặc 2 (cùng team) trong MX. [CHỜ XINH] rà ma trận.
const shows = (idx: number) =>
  Object.entries(MX)
    .filter(([, v]) => v[idx] > 0)
    .map(([k]) => {
      const c = CASES.find((x) => x.key === k);
      return { n: c ? c.brand : clientName(k), href: c ? `/du-an/${c.slug}/` : '/du-an/' };
    });
const half = Math.ceil(BRANDS.length / 2);
const rows = [BRANDS.slice(0, half), BRANDS.slice(half)];
---

<section class="proof sec" id="nang-luc" data-proof>
  <div class="wrap">
    <div class="proof__top">
      <h2 class="h2 proof__t">{PROOF.title}</h2>
      <p class="lead" data-rv>{PROOF.body}</p>
    </div>

    <div class="proof__stats">
      {PROOF.stats.map((s, i) => (
        <div class="proof__stat" data-rv style={`--d:${i}`}>
          <b data-count={s.n}>{s.n}</b>
          <span class="state">{s.l}</span>
        </div>
      ))}
    </div>
  </div>

  <div class="marquee" aria-label={`20 thương hiệu: ${BRANDS.join(', ')}`}>
    {rows.map((r, i) => (
      <div class:list={['marquee__row', i === 1 && 'is-rev']} aria-hidden="true">
        <div class="marquee__set">{r.map((b) => <span>{b}</span>)}</div>
        <div class="marquee__set">{r.map((b) => <span>{b}</span>)}</div>
      </div>
    ))}
  </div>
  <p class="wrap small soft proof__note">{PROOF.brandNote}</p>

  <div class="wrap skills">
    {groups.map((g) => (
      <div class="skills__g">
        <h3 class="skills__gt">{g.t}</h3>
        <ul class="skills__list">
          {SKILLS.map((s, idx) => ({ s, idx })).filter(({ s }) => s.g === g.g).map(({ s, idx }) => (
            <li class="skill" data-rv>
              <h4 class="skill__t">{s.t}</h4>
              <p class="soft">{s.d}</p>
              <p class="skill__shows small">
                <span class="soft">Thể hiện qua</span>
                {shows(idx).map((x) => <a href={x.href}>{x.n}</a>)}
              </p>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>
</section>

<style>
  .proof { background: var(--peach); border-radius: 40px; margin-inline: clamp(6px, 1vw, 14px); }
  .proof__top { display: grid; grid-template-columns: 1fr auto; align-items: end; gap: 24px 48px; }
  .proof__t { max-width: 11ch; }
  .proof__stats { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(24px, 4vw, 64px); margin-top: clamp(48px, 7vw, 110px); }
  .proof__stat { display: grid; gap: 12px; }
  .proof__stat b { font-size: clamp(140px, 24vw, 420px); line-height: 0.78; letter-spacing: -0.07em; font-weight: 800; color: var(--acc); font-variant-numeric: tabular-nums; }
  .proof__stat .state { max-width: 18ch; }

  .marquee { margin-top: clamp(64px, 9vw, 140px); display: grid; gap: 10px; overflow: clip; }
  .marquee__row { display: flex; width: max-content; animation: slide 60s linear infinite; }
  .marquee__row.is-rev { animation-direction: reverse; }
  .marquee__set { display: flex; gap: 10px; padding-right: 10px; }
  .marquee__set span { padding: 14px 26px; border-radius: 999px; background: var(--bg); font-size: clamp(20px, 2vw, 32px); font-weight: 650; letter-spacing: -0.03em; white-space: nowrap; }
  .marquee:hover .marquee__row { animation-play-state: paused; }
  @keyframes slide { to { transform: translateX(-50%); } }
  .proof__note { margin-top: 18px; }

  .skills { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(32px, 5vw, 96px); margin-top: clamp(80px, 10vw, 160px); }
  .skills__gt { font-size: clamp(30px, 3.4vw, 56px); margin-bottom: 20px; }
  .skills__list { display: grid; gap: 10px; }
  .skill { display: grid; gap: 10px; padding: clamp(20px, 2vw, 28px); border-radius: 24px; background: rgb(255 250 248 / 0.7); }
  .skill__t { font-size: clamp(21px, 1.7vw, 27px); font-weight: 700; letter-spacing: -0.025em; line-height: 1.1; }
  .skill__shows { display: flex; flex-wrap: wrap; align-items: center; gap: 6px; }
  .skill__shows span { margin-right: 4px; }
  .skill__shows a { padding: 5px 12px; border-radius: 999px; background: var(--bg); font-weight: 600; transition: background var(--t-fast), color var(--t-fast); }
  .skill__shows a:hover { background: var(--acc); color: var(--acc-ink); }
  @media (max-width: 860px) {
    .proof { border-radius: 28px; }
    .proof__top, .skills { grid-template-columns: 1fr; }
    .proof__stats { grid-template-columns: 1fr; }
  }
</style>

---
import { PROOF, BRANDS, SKILLS, MX } from '../data/site';
import { CASES } from '../data/work';
const groups = [
  { g: 'run', label: 'WHAT I RUN' },
  { g: 'own', label: 'HOW FAR I TAKE IT' },
] as const;
// Dự án thể hiện từng năng lực (theo ma trận MX, chỉ các case có trang riêng).
const proofOf = (i: number) => CASES.filter((c) => (MX[c.key] ?? [])[i]).map((c) => ({ slug: c.slug, brand: c.brand }));
---

<section class="sec proof" id="bang-chung">
  <div class="wrap">
    <div class="sec-head">
      <span class="pill"><span class="dot"></span>{PROOF.eyebrow}</span>
      <h2 class="h2" data-reveal>{PROOF.title}</h2>
      <p class="lead" data-reveal style="--i:1">{PROOF.body}</p>
    </div>

    <div class="proof__stats">
      {PROOF.stats.map((s, i) => (
        <div class="proof__stat" data-reveal style={`--i:${i}`}>
          <span class="proof__n">{s.n}</span>
          <span class="proof__l">{s.l}</span>
        </div>
      ))}
      <p class="mono muted proof__ind">{PROOF.industries}</p>
    </div>
  </div>

  <div class="proof__marquee" aria-label={`20 thương hiệu: ${BRANDS.join(', ')}`}>
    <div class="proof__belt" aria-hidden="true">
      {[0, 1].map(() => (
        <ul>{BRANDS.map((b) => <li>{b}</li>)}</ul>
      ))}
    </div>
  </div>
  <p class="wrap mono muted proof__note">{PROOF.brandNote}</p>

  <div class="wrap proof__skills" data-skills>
    {groups.map((grp) => (
      <div class="proof__group">
        <p class="mono accent">{grp.label}</p>
        <ul>
          {SKILLS.map((s, i) => s.g === grp.g && (
            <li>
              <details class="skill">
                <summary class="skill__t"><span>{s.t}</span><span class="skill__plus" aria-hidden="true">+</span></summary>
                <div class="skill__body">
                  <p class="muted">{s.d}</p>
                  {proofOf(i).length > 0 && (
                    <p class="skill__proof"><span class="mono">Dự án liên quan</span>
                      {proofOf(i).map((c) => <a class="pill" href={`/du-an/${c.slug}/`}>{c.brand}</a>)}
                    </p>
                  )}
                </div>
              </details>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>
</section>

<style>
  .proof { background: var(--paper-2); overflow: hidden; }
  .proof__stats { display: flex; flex-wrap: wrap; align-items: flex-end; gap: clamp(24px, 6vw, 96px); }
  .proof__stat { display: grid; }
  .proof__n { font-size: clamp(110px, 18vw, 260px); font-weight: 800; line-height: 0.82; letter-spacing: -0.06em; color: var(--accent); }
  .proof__l { font-family: var(--f-serif); font-style: italic; font-size: clamp(20px, 2vw, 28px); max-width: 14ch; line-height: 1.2; margin-top: 12px; }
  .proof__ind { margin-left: auto; align-self: end; }

  .proof__marquee { margin-top: clamp(56px, 8vw, 104px); border-block: 1px solid var(--line); padding: 22px 0; }
  .proof__belt { display: flex; width: max-content; animation: belt 70s linear infinite; }
  .proof__marquee:hover .proof__belt { animation-play-state: paused; }
  .proof__belt ul { display: flex; gap: 48px; padding-right: 48px; }
  .proof__belt li { font-size: clamp(22px, 2.4vw, 34px); font-weight: 700; letter-spacing: -0.02em; white-space: nowrap; }
  .proof__belt li:nth-child(3n + 2) { font-family: var(--f-serif); font-style: italic; font-weight: 400; }
  @keyframes belt { to { transform: translateX(-50%); } }
  .proof__note { margin-top: 12px; }

  .proof__skills { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(24px, 4vw, 64px); margin-top: clamp(56px, 8vw, 104px); }
  .proof__group { display: grid; gap: 12px; align-content: start; }
  .skill { border-bottom: 1px solid var(--line); }
  .skill__t { display: flex; justify-content: space-between; align-items: center; gap: 16px; padding: 16px 0; cursor: pointer; list-style: none; font-weight: 600; font-size: clamp(18px, 1.6vw, 22px); }
  .skill__t::-webkit-details-marker { display: none; }
  .skill__plus { color: var(--accent); font-size: 24px; transition: transform var(--t-fast) var(--ease); }
  .skill[open] .skill__plus { transform: rotate(45deg); }
  .skill__body { display: grid; gap: 12px; padding-bottom: 18px; }
  .skill__proof { display: flex; flex-wrap: wrap; align-items: center; gap: 6px; }
  .skill__proof .mono { margin-right: 6px; color: var(--ink-2); }
  .skill__proof a:hover { background: var(--accent); color: var(--accent-ink); border-color: var(--accent); }
  @media (max-width: 820px) { .proof__skills { grid-template-columns: 1fr; } .proof__ind { margin-left: 0; } }
</style>

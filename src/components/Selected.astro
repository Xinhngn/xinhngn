---
import { CASES, JOBS } from '../data/work';
---

<section class="sel sec" id="du-an" data-selected>
  <div class="wrap">
    <div class="sel__head">
      <h2 class="h2">Dự án chọn lọc</h2>
      <a class="btn btn--ghost" href="/du-an/" data-magnet>Xem tất cả {JOBS.length} chiến dịch <span class="arr" aria-hidden="true">→</span></a>
    </div>

    <ol class="sel__list">
      {CASES.map((c, i) => (
        <li>
          <a class="sel__row" href={`/du-an/${c.slug}/`} data-i={i}>
            <span class="sel__brand">{c.brand}</span>
            <span class="sel__info">
              <span class="sel__title">{c.title}</span>
              <span class="small soft">{c.meta}</span>
            </span>
            <span class="sel__go" aria-hidden="true">→</span>
          </a>
        </li>
      ))}
    </ol>
  </div>

  <div class="sel__float glass" aria-hidden="true" data-float>
    {CASES.map((c) => (
      <div class="sel__card">
        <p class="sel__tag">{c.tagline}</p>
        {c.role && <p class="small soft">{c.role}</p>}
        <p class="sel__res">{c.results[0] && <><b>{c.results[0].b}</b> <span class="small">{c.results[0].l}</span></>}</p>
      </div>
    ))}
  </div>
</section>

<style>
  .sel__head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: end; gap: 24px; margin-bottom: clamp(40px, 5vw, 80px); }
  .sel__list { display: grid; }
  .sel__row { position: relative; display: grid; grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr) auto; align-items: center; gap: 24px; padding: clamp(18px, 2vw, 30px) 0; isolation: isolate; }
  .sel__row::before { content: ''; position: absolute; inset: 0 calc(var(--gut) * -1); z-index: -1; background: var(--blush); border-radius: 26px; transform: scaleY(0.2); opacity: 0; transition: transform 0.5s var(--ease), opacity 0.3s; }
  .sel__row:hover::before, .sel__row:focus-visible::before { transform: none; opacity: 1; }
  .sel__brand { font-size: clamp(44px, 7vw, 132px); text-wrap: balance; font-weight: 780; letter-spacing: -0.055em; line-height: 0.9; transition: transform 0.5s var(--ease), color 0.3s; }
  .sel__row:hover .sel__brand { transform: translateX(16px); color: var(--acc); }
  .sel__info { display: grid; gap: 6px; }
  .sel__title { font-size: clamp(19px, 1.6vw, 26px); font-weight: 650; letter-spacing: -0.02em; line-height: 1.15; }
  .sel__go { font-size: clamp(28px, 3vw, 48px); transition: transform 0.4s var(--ease); }
  .sel__row:hover .sel__go { transform: translateX(8px) rotate(-45deg); }

  .sel__float { position: fixed; left: 0; top: 0; z-index: 30; width: 300px; padding: 22px; border-radius: 24px; pointer-events: none; opacity: 0; transform: translate(-50%, -50%) scale(0.85); transition: opacity 0.25s, transform 0.4s var(--ease); display: none; }
  .sel__float.is-on { opacity: 1; }
  .sel__card { display: none; gap: 10px; }
  .sel__card.is-on { display: grid; }
  .sel__tag { font-size: 22px; font-weight: 650; letter-spacing: -0.02em; line-height: 1.15; }
  .sel__res b { font-size: 34px; letter-spacing: -0.04em; color: var(--acc); }
  @media (hover: hover) and (min-width: 900px) { .sel__float { display: block; } }
  @media (max-width: 760px) {
    .sel__row { grid-template-columns: 1fr auto; gap: 8px 16px; }
    .sel__info { grid-column: 1; }
    .sel__go { grid-row: 1; grid-column: 2; }
  }
</style>

---
import { CASES } from '../data/work';
---

<section class="sec sel" id="du-an-chon-loc">
  <div class="wrap">
    <div class="sec-head">
      <span class="pill"><span class="dot"></span>Selected work</span>
      <h2 class="h2" data-reveal>Không chỉ nhận brief. <span class="it accent">Còn đưa việc đến đích.</span></h2>
      <p class="lead" data-reveal style="--i:1">Những dự án cho thấy cách Xinh làm rõ bài toán, phát triển cơ hội hợp tác và theo sát quá trình triển khai.</p>
    </div>

    <div class="sel__grid" data-selected>
      <ol class="sel__list">
        {CASES.map((c, i) => (
          <li>
            <a class:list={['sel__row', { 'is-on': i === 0 }]} href={`/du-an/${c.slug}/`} data-i={i}>
              <span class="mono sel__n">0{i + 1}</span>
              <span class="sel__brand">{c.brand}</span>
              <span class="sel__tag it">{c.tagline}</span>
              <span class="mono sel__meta">{c.meta}</span>
            </a>
          </li>
        ))}
      </ol>

      <div class="sel__view" aria-hidden="true">
        {CASES.map((c, i) => (
          <article class:list={['sel__card', { 'is-on': i === 0 }]} data-i={i}>
            <p class="mono sel__cmeta">0{i + 1} / 0{CASES.length}{c.role && ` · ${c.role}`}</p>
            <p class="sel__title">{c.title}</p>
            <div class="sel__res">
              {c.results.slice(0, 3).map((r) => (
                <p><b>{r.b}</b><span>{r.l}</span></p>
              ))}
            </div>
            <p class="sel__big">{c.brand}</p>
          </article>
        ))}
      </div>
    </div>

    <a class="btn btn--ghost sel__all" href="/du-an/">Xem tất cả dự án <span class="arr">→</span></a>
  </div>
</section>

<style>
  .sel__grid { display: grid; grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr); gap: clamp(24px, 4vw, 56px); align-items: start; }
  .sel__list { border-top: 1px solid var(--line); }
  .sel__row { display: grid; grid-template-columns: 44px 1fr; grid-template-areas: 'n brand' '. tag' '. meta'; column-gap: 8px; row-gap: 4px; padding: 22px 0; border-bottom: 1px solid var(--line); transition: padding var(--t-fast) var(--ease); }
  .sel__n { grid-area: n; padding-top: 10px; color: var(--ink-3); }
  .sel__brand { grid-area: brand; font-size: clamp(30px, 3.6vw, 54px); font-weight: 800; letter-spacing: -0.035em; line-height: 1; transition: color var(--t-fast); }
  .sel__tag { grid-area: tag; font-size: 19px; color: var(--ink-2); }
  .sel__meta { grid-area: meta; color: var(--ink-3); }
  .sel__row:hover, .sel__row.is-on { padding-left: 10px; }
  .sel__row.is-on .sel__brand, .sel__row:hover .sel__brand { color: var(--accent); }
  .sel__row.is-on .sel__n { color: var(--accent); }

  .sel__view { position: sticky; top: 96px; aspect-ratio: 4 / 5; max-height: calc(100svh - 120px); width: 100%; }
  .sel__card { position: absolute; inset: 0; display: flex; flex-direction: column; gap: 16px; padding: clamp(20px, 2.4vw, 32px); border-radius: calc(var(--r) + 6px); background: var(--accent); color: var(--accent-ink); overflow: hidden; opacity: 0; transform: translateY(18px) scale(0.98); transition: opacity 0.5s var(--ease), transform 0.6s var(--ease); }
  .sel__card:nth-child(2n) { background: var(--blush); color: var(--ink); }
  .sel__card:nth-child(2n) .sel__big { color: var(--accent); }
  .sel__card.is-on { opacity: 1; transform: none; }
  .sel__title { font-size: clamp(24px, 2.4vw, 36px); font-weight: 700; line-height: 1.1; letter-spacing: -0.02em; max-width: 16ch; }
  .sel__res { display: grid; gap: 10px; margin-top: auto; }
  .sel__res p { display: flex; align-items: baseline; gap: 10px; border-top: 1px solid currentColor; padding-top: 10px; opacity: 0.95; }
  .sel__res b { font-size: clamp(22px, 2.2vw, 30px); letter-spacing: -0.02em; }
  .sel__res span { font-size: 14px; }
  .sel__big { font-size: clamp(64px, 9vw, 150px); font-weight: 800; letter-spacing: -0.05em; line-height: 0.82; margin: 0 0 -0.08em -0.04em; text-wrap: balance; }
  .sel__all { margin-top: 40px; }
  @media (max-width: 900px) {
    .sel__grid { grid-template-columns: 1fr; }
    .sel__view { display: none; }
  }
</style>

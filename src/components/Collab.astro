---
import { COLLAB } from '../data/site';
const { solo, squad, promise } = COLLAB;
---

<section class="sec collab" id="hop-tac">
  <div class="wrap">
    <div class="sec-head">
      <span class="pill"><span class="dot"></span>{COLLAB.eyebrow}</span>
      <h2 class="h2" data-reveal>{COLLAB.title}</h2>
      <p class="lead" data-reveal style="--i:1">{COLLAB.body}</p>
    </div>

    <div class="collab__grid">
      <article class="ticket" data-reveal>
        <div class="ticket__top">
          <span class="pill">{solo.tag}</span>
          <h3 class="h2 ticket__t">{solo.title}</h3>
          <p class="muted">{solo.body}</p>
          <p class="it ticket__fit">{solo.fit}</p>
        </div>
        <div class="ticket__cut" aria-hidden="true"></div>
        <div class="ticket__bot">
          <a class="btn" href="#lien-he" data-open-win="mail">{solo.cta} <span class="arr">→</span></a>
          <span class="ticket__code mono" aria-hidden="true">SOLO-01</span>
        </div>
      </article>

      <article class="ticket ticket--blush" data-reveal style="--i:1">
        <div class="ticket__top">
          <span class="pill">{squad.tag}</span>
          <h3 class="h2 ticket__t">{squad.title}</h3>
          <p class="muted">{squad.body}</p>
          <ul class="ticket__net">{squad.network.map((n) => <li class="pill">{n}</li>)}</ul>
        </div>
        <div class="ticket__cut" aria-hidden="true"></div>
        <div class="ticket__bot">
          <a class="btn" href="#lien-he" data-open-win="mail">{squad.cta} <span class="arr">→</span></a>
          <span class="ticket__code mono" aria-hidden="true">SQUAD-09</span>
        </div>
      </article>
    </div>

    <div class="collab__promise" data-reveal>
      <p class="mono accent">{promise.title}</p>
      <ul>{promise.items.map((p) => <li><span class="dot"></span>{p}</li>)}</ul>
    </div>
  </div>
</section>

<style>
  .collab__grid { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(16px, 2vw, 28px); }
  .ticket { display: flex; flex-direction: column; border-radius: calc(var(--r) + 4px); background: #fffdf9; border: 1px solid var(--line); transition: transform 0.5s var(--ease); }
  .ticket:hover { transform: translateY(-4px) rotate(-0.4deg); }
  .ticket--blush { background: var(--blush-2); }
  .ticket__top { display: grid; gap: 16px; align-content: start; padding: clamp(22px, 3vw, 36px); flex: 1; }
  .ticket__top .pill { justify-self: start; }
  .ticket__t { font-size: clamp(28px, 3.2vw, 48px); }
  .ticket__fit { font-size: 19px; color: var(--ink-2); }
  .ticket__net { display: flex; flex-wrap: wrap; gap: 6px; }
  .ticket__cut { position: relative; height: 0; border-top: 2px dashed var(--line); margin: 0 18px; }
  .ticket__cut::before, .ticket__cut::after { content: ''; position: absolute; top: -13px; width: 24px; height: 24px; border-radius: 50%; background: var(--paper); border: 1px solid var(--line); }
  .ticket__cut::before { left: -32px; clip-path: inset(0 0 0 50%); }
  .ticket__cut::after { right: -32px; clip-path: inset(0 50% 0 0); }
  .ticket__bot { display: flex; justify-content: space-between; align-items: center; gap: 12px; padding: 20px clamp(22px, 3vw, 36px); }
  .ticket__code { color: var(--ink-3); background: repeating-linear-gradient(90deg, var(--ink) 0 2px, transparent 2px 4px, var(--ink) 4px 5px, transparent 5px 8px); -webkit-background-clip: text; background-clip: text; padding: 18px 0 0; border-top: 0; position: relative; }
  .ticket__code::before { content: ''; position: absolute; left: 0; right: 0; top: 0; height: 14px; background: repeating-linear-gradient(90deg, var(--ink) 0 2px, transparent 2px 4px, var(--ink) 4px 5px, transparent 5px 8px); opacity: 0.8; }
  .collab__promise { display: grid; gap: 14px; margin-top: clamp(32px, 5vw, 56px); padding-top: 24px; border-top: 1px solid var(--line); }
  .collab__promise ul { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; }
  .collab__promise li { display: flex; gap: 10px; align-items: baseline; font-weight: 600; }
  @media (max-width: 900px) {
    .collab__grid { grid-template-columns: 1fr; }
    .collab__promise ul { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 520px) { .collab__promise ul { grid-template-columns: 1fr; } }
</style>

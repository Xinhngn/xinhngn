---
import { BRIEF } from '../data/site';
---

<section class="brief sec" id="de-bai" data-brief>
  <div class="wrap brief__in">
    <div class="brief__head">
      <h2 class="brief__t">{BRIEF.title}</h2>
      <p class="lead" data-rv>{BRIEF.body}</p>
    </div>
    <ul class="brief__cards">
      {BRIEF.cards.map((c, i) => (
        <li class="brief__card" style={`--k:${i}`}>
          <span class="brief__mark" aria-hidden="true"></span>
          <p>{c}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .brief { background: var(--blush); border-radius: 40px 40px 0 0; }
  .brief__in { display: grid; grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr); gap: clamp(32px, 6vw, 120px); align-items: start; }
  .brief__head { position: sticky; top: 120px; display: grid; gap: 28px; }
  .brief__t { font-size: clamp(40px, 4.6vw, 84px); line-height: 0.98; }
  .brief__cards { display: grid; gap: 14px; }
  .brief__card { display: grid; grid-template-columns: auto 1fr; gap: 20px; align-items: center; padding: clamp(22px, 2.4vw, 34px); border-radius: 26px; background: var(--bg); font-size: clamp(22px, 2.1vw, 34px); font-weight: 600; line-height: 1.12; letter-spacing: -0.025em; transform-origin: 50% 50%; will-change: transform; }
  .brief__mark { width: 22px; height: 22px; border-radius: 50%; box-shadow: inset 0 0 0 2.5px var(--acc); transition: background 0.4s var(--ease); }
  .brief__card.is-set .brief__mark { background: var(--acc); }
  @media (max-width: 860px) {
    .brief { border-radius: 28px 28px 0 0; }
    .brief__in { grid-template-columns: 1fr; }
    .brief__head { position: static; }
  }
</style>

---
import { PROMISE } from '../data/site';
const words = (s: string) => s.split(' ');
---

<section class="promise sec" id="loi-hua" data-promise>
  <div class="wrap promise__in">
    <h2 class="promise__t">
      <span class="promise__l">{words(PROMISE.lead).map((w) => <span class="w">{w} </span>)}</span>
      <span class="promise__l acc">{words(PROMISE.turn).map((w) => <span class="w">{w} </span>)}</span>
    </h2>
    <p class="lead promise__b" data-rv>{PROMISE.body}</p>
  </div>
</section>

<style>
  .promise__in { display: grid; gap: clamp(32px, 5vw, 72px); }
  .promise__t { font-size: clamp(40px, 8.4vw, 150px); line-height: 0.98; letter-spacing: -0.045em; }
  .promise__l { display: block; }
  .promise__b { justify-self: end; max-width: 40ch; }
  /* chữ sáng dần theo cuộn: --o do scripts/motion.ts đặt */
  .promise__t .w { opacity: var(--o, 1); }
</style>

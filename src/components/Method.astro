---
import { METHOD, STEPS } from '../data/site';
// Đường gợn sóng: biên độ giảm dần về 0 khi cuộn (scripts/motion.ts vẽ lại).
const W = 1600;
const wave = (amp: number) => {
  let d = `M0 60`;
  for (let x = 0; x <= W; x += 20) d += ` L${x} ${(60 + Math.sin(x / 47) * amp * Math.sin(x / 310 + 1)).toFixed(1)}`;
  return d;
};
---

<section class="method sec" id="cach-lam" data-method>
  <div class="wrap method__head">
    <h2 class="h2 method__t">{METHOD.title}</h2>
  </div>

  <div class="method__pin">
    <svg class="method__wave" viewBox={`0 0 ${W} 120`} preserveAspectRatio="none" aria-hidden="true">
      <path d={wave(46)} data-wave data-w={W} />
    </svg>
    <ol class="method__track wrap">
      {STEPS.map((s, i) => (
        <li class="method__step" style={`--k:${i}`}>
          <h3 class="method__name">{s.t}</h3>
          <p class="state method__k">{s.k}</p>
          <p class="method__d">{s.d}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .method__head { margin-bottom: clamp(40px, 6vw, 96px); }
  .method__t { max-width: 13ch; }
  .method__pin { position: relative; overflow: clip; }
  .method__wave { width: 100%; height: clamp(70px, 9vw, 120px); overflow: visible; }
  .method__wave path { fill: none; stroke: var(--acc); stroke-width: 3; vector-effect: non-scaling-stroke; stroke-linecap: round; }
  .method__track { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: clamp(28px, 4vw, 64px) clamp(24px, 4vw, 72px); margin-top: clamp(24px, 3vw, 48px); }
  .method__step { display: grid; gap: 16px; align-content: start; }
  .method__name { font-size: clamp(52px, 9.4vw, 176px); letter-spacing: -0.05em; color: var(--acc); }
  .method__k { font-weight: 600; }
  .method__d { max-width: 42ch; color: var(--ink); font-size: clamp(17px, 1.3vw, 21px); }

  /* ngang + ghim khi JS bật trên màn rộng (lớp do motion.ts thêm) */
  .method.is-h .method__pin { height: 100svh; display: flex; flex-direction: column; justify-content: center; gap: 2vh; }
  .method.is-h .method__step { padding-top: 2vh; }
  .method.is-h .method__track { display: flex; width: max-content; max-width: none; gap: 0; padding-right: 0; }
  .method.is-h .method__step { width: min(70vw, 1080px); padding-right: clamp(40px, 6vw, 120px); }
  @media (max-width: 760px) { .method__track { grid-template-columns: 1fr; } }
</style>

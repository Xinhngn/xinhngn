{
  "name": "xinh-os",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:artifact": "vite build --config vite.artifact.config.ts",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "check:shots": "node tools/shots.mjs",
    "check:jumps": "node tools/scan-jumps.mjs",
    "check:fit": "node tools/fit.mjs",
    "check:perf": "node tools/perf.mjs",
    "check:idle": "node tools/idle.mjs"
  },
  "dependencies": {
    "gsap": "^3.13.0",
    "lenis": "^1.3.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.15.0",
    "jsdom": "^26.1.0",
    "typescript": "~5.8.3",
    "vite": "^6.3.5",
    "vite-plugin-singlefile": "^2.3.0",
    "vitest": "^3.2.4"
  }
}
